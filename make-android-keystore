#!/usr/bin/env bash
# Generate a production-grade Android upload/signing keystore.
# Password is generated by 1Password; keystore file + fingerprints are saved to the same 1P item.
# Usage: make-android-keystore <name> [--alias upload] [--cn "Common Name"] [--out dir] [--vault "Vault"] [--account <url>]
set -euo pipefail

usage() {
  echo "Usage: make-android-keystore <name> [options]"
  echo "  --alias <alias>     key alias (default: upload; auto-detected with --import)"
  echo "  --cn <name>         certificate common name (default: keystore name)"
  echo "  --out <dir>         output directory (default: .)"
  echo "  --import <file>     store an existing keystore in 1Password instead of generating one"
  echo "  --vault <vault>     1Password vault (default: interactive picker)"
  echo "  --account <url>     1Password account url (default: interactive picker)"
  echo "  --force             overwrite an existing keystore file"
  echo "  --keep              keep the generated keystore file locally (default: removed after upload)"
  echo "  Creates <dir>/<name>.keystore (PKCS12, RSA 4096, valid 30y)."
  echo "  Password is generated and stored in 1Password, keystore file attached to the item."
  exit 1
}

[[ $# -ge 1 && $1 != -* ]] || usage
NAME="$1"; shift
ALIAS=""
CN=""
OUT="."
VAULT=""
ACCOUNT=""
FORCE=0
IMPORT=""
KEEP=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --alias)   ALIAS="$2"; shift 2 ;;
    --cn)      CN="$2"; shift 2 ;;
    --out)     OUT="$2"; shift 2 ;;
    --vault)   VAULT="$2"; shift 2 ;;
    --account) ACCOUNT="$2"; shift 2 ;;
    --import)  IMPORT="$2"; shift 2 ;;
    --force)   FORCE=1; shift ;;
    --keep)    KEEP=1; shift ;;
    *) usage ;;
  esac
done

CN="${CN:-$NAME}"
TITLE="$NAME Android Keystore"
if [[ -n "$IMPORT" ]]; then
  [[ -f "$IMPORT" ]] || { echo "Keystore not found: $IMPORT" >&2; exit 1; }
  FILE="$IMPORT"
else
  FILE="$OUT/$NAME.keystore"
  if [[ -e "$FILE" ]]; then
    if [[ $FORCE -eq 1 ]]; then rm -f "$FILE"
    else echo "Refusing to overwrite existing $FILE (use --force)" >&2; exit 1; fi
  fi
fi
command -v op >/dev/null || { echo "1Password CLI (op) not found" >&2; exit 1; }
command -v keytool >/dev/null || { echo "keytool not found (install a JDK)" >&2; exit 1; }

pick() { # pick "prompt" <<< "option-lines" -> REPLY_PICK (first option is the suggested default)
  local prompt="$1" options=()
  while IFS= read -r line; do [[ -n "$line" ]] && options+=("$line"); done
  if [[ ${#options[@]} -eq 1 ]]; then REPLY_PICK="${options[0]}"; return; fi
  echo "$prompt" >&2
  local i
  for i in "${!options[@]}"; do
    printf '  %d) %s%s\n' "$((i + 1))" "${options[$i]}" "$([[ $i -eq 0 ]] && echo '  (suggested)')" >&2
  done
  local choice
  read -rp "Choice [1]: " choice < /dev/tty
  choice="${choice:-1}"
  [[ "$choice" =~ ^[0-9]+$ && "$choice" -ge 1 && "$choice" -le ${#options[@]} ]] || { echo "Invalid choice" >&2; exit 1; }
  REPLY_PICK="${options[$((choice - 1))]}"
}

if [[ -z "$ACCOUNT" ]]; then
  # suggest work accounts (non-personal domains) first
  pick "1Password account:" <<< "$(op account list --format json \
    | jq -r 'sort_by(.url | test("my\\.1password\\.com")) | .[] | "\(.url)  (\(.email))"')"
  ACCOUNT="${REPLY_PICK%% *}"
fi

if [[ -z "$VAULT" ]]; then
  # suggest publishing/store vaults first
  pick "Vault in $ACCOUNT:" <<< "$(op vault list --account "$ACCOUNT" --format json \
    | jq -r 'sort_by(.name | test("publish|app store|play"; "i") | not) | .[].name')"
  VAULT="$REPLY_PICK"
fi

if [[ -n "$IMPORT" ]]; then
  read -rsp "Keystore password: " PASSWORD < /dev/tty; echo
  LISTING="$(keytool -list -keystore "$FILE" -storepass "$PASSWORD")" \
    || { echo "Could not open $FILE (wrong password?)" >&2; exit 1; }
  if [[ -z "$ALIAS" ]]; then
    ALIASES="$(grep -i 'PrivateKeyEntry' <<<"$LISTING" | cut -d, -f1)"
    [[ -n "$ALIASES" ]] || { echo "No key entry found; specify --alias" >&2; exit 1; }
    pick "Key alias in $FILE:" <<< "$ALIASES"
    ALIAS="$REPLY_PICK"
    echo "Using alias: $ALIAS"
  fi
  read -rsp "Key password (empty = same as store password): " KEY_PASSWORD < /dev/tty; echo
  KEY_PASSWORD="${KEY_PASSWORD:-$PASSWORD}"
else
  ALIAS="${ALIAS:-upload}"
fi

echo "Creating 1Password item '$TITLE' in vault '$VAULT' ($ACCOUNT)..."
if [[ -n "$IMPORT" ]]; then
  ITEM_JSON="$(op item create --account "$ACCOUNT" --category Password --title "$TITLE" --vault "$VAULT" \
    "password=$PASSWORD" --format json)"
else
  ITEM_JSON="$(op item create --account "$ACCOUNT" --category Password --title "$TITLE" --vault "$VAULT" \
    --generate-password='letters,digits,32' --format json)"
  PASSWORD="$(jq -r '.fields[] | select(.id == "password") | .value' <<<"$ITEM_JSON")"
  [[ -n "$PASSWORD" && "$PASSWORD" != "null" ]] || { echo "1Password did not return a generated password" >&2; exit 1; }
  KEY_PASSWORD="$PASSWORD"

  keytool -genkeypair -v \
    -keystore "$FILE" \
    -storetype PKCS12 \
    -alias "$ALIAS" \
    -keyalg RSA -keysize 4096 \
    -validity 10950 \
    -storepass "$PASSWORD" \
    -dname "CN=$CN, O=$CN"
fi
ITEM_ID="$(jq -r '.id' <<<"$ITEM_JSON")"

FINGERPRINTS="$(keytool -list -v -keystore "$FILE" -storepass "$PASSWORD" -alias "$ALIAS")"
SHA1="$(grep 'SHA1:' <<<"$FINGERPRINTS" | sed 's/.*SHA1: //')"
SHA256="$(grep 'SHA256:' <<<"$FINGERPRINTS" | sed 's/.*SHA256: //')"

echo "Attaching keystore + metadata to 1Password item..."
op item edit "$ITEM_ID" --account "$ACCOUNT" --vault "$VAULT" \
  "alias[text]=$ALIAS" \
  "storePassword[password]=$PASSWORD" \
  "keyPassword[password]=$KEY_PASSWORD" \
  "sha1[text]=$SHA1" \
  "sha256[text]=$SHA256" \
  "base64[password]=$(base64 -i "$FILE")" \
  "$NAME\.keystore[file]=$FILE" >/dev/null

if [[ -z "$IMPORT" && $KEEP -eq 0 ]]; then
  rm -f "$FILE"
  KEYSTORE_LINE="in 1Password only (local file removed; use --keep to keep it)"
else
  KEYSTORE_LINE="$FILE"
fi

echo
echo "Keystore : $KEYSTORE_LINE"
echo "Alias    : $ALIAS"
echo "1P item  : $TITLE ($VAULT @ $ACCOUNT)"
echo "SHA1     : $SHA1"
echo "SHA256   : $SHA256"
echo
echo "Password is in 1Password only."
echo "CI secret: op read \"op://$VAULT/$TITLE/base64\" --account $ACCOUNT | gh secret set KEYSTORE_FILE ..."
